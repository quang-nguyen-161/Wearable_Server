# ThingsBoard Cloud (HUST 2Slab)
TB_BASE_URL=https://c7.hust-2slab.org
TB_USERNAME=tenant@thingsboard.org
TB_PASSWORD=tenant

# Gateway Device UUID on ThingsBoard (nếu có)
TB_DEVICE_ID=

# Gateway access token (trùng khớp với token trong ESP32 firmware)
TB_GATEWAY_ACCESS_TOKEN=NPupkjwg0hoAPiPh4cTk

# MQTT Broker URI
TB_MQTT_BROKER=mqtt://103.116.39.179:1883
TB_MQTT_BROKER_FALLBACK=mqtt://103.116.39.179:1883

# Public frontend variables (cho trình duyệt Next.js)
NEXT_PUBLIC_TB_BASE_URL=https://c7.hust-2slab.org
NEXT_PUBLIC_TB_WS_URL=wss://c7.hust-2slab.org/api/ws/plugins/telemetry
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Architecture v2 Production Database & Auth Security
DB_DRIVER=memory
JWT_SECRET=wearable-production-super-secret-jwt-key-32chars
